// engine/win/veltra.rc - resources of the Windows desktop app veltra.exe: icon, manifest, version info.
//   x86_64-w64-mingw32-windres engine/win/veltra.rc -O coff -o veltra_res.o   (CMake compiles it automatically)
#include <winver.h>

// 1 = the app icon (window class + Explorer); CREATEPROCESS_MANIFEST_RESOURCE_ID (1) / RT_MANIFEST (24)
1 ICON "veltra.ico"
1 24 "veltra.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Veltra"
      VALUE "FileDescription", "Veltra"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "veltra"
      VALUE "OriginalFilename", "veltra.exe"
      VALUE "ProductName", "Veltra"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
