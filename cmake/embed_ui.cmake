# cmake -DOUT=<header> -DROOT=<source dir> -DFILES="chat/index.html,chat/benchmarks.html,..." -P embed_ui.cmake
# An entry "path@name" embeds <path> under <name> (desktop_ui/index.html@desktop.html); otherwise the file name is used.
# Turns the web front-end into a C++ header (generated/embedded_ui.h) so veltra.exe needs no HTML/JS folder next to it.
string(REPLACE "," ";" _files "${FILES}")
set(_body "")
set(_table "")
set(_i 0)
foreach(_entry IN LISTS _files)
  set(_rel "${_entry}")
  set(_name "")
  if(_entry MATCHES "^([^@]+)@(.+)$")
    set(_rel "${CMAKE_MATCH_1}")
    set(_name "${CMAKE_MATCH_2}")
  endif()
  set(_path "${ROOT}/${_rel}")
  if(NOT EXISTS "${_path}")
    message(FATAL_ERROR "embed_ui: missing ${_path}")
  endif()
  file(READ "${_path}" _hex HEX)
  file(SIZE "${_path}" _size)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  # break the initializer every 32 bytes (keeps compiler line lengths sane)
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
  if(_name STREQUAL "")
    get_filename_component(_name "${_rel}" NAME)
  endif()
  if(_name MATCHES "\\.html$")
    set(_type "text/html; charset=utf-8")
  elseif(_name MATCHES "\\.json$")
    set(_type "application/json")
  elseif(_name MATCHES "\\.js$")
    set(_type "text/javascript; charset=utf-8")
  elseif(_name MATCHES "\\.css$")
    set(_type "text/css; charset=utf-8")
  else()
    set(_type "application/octet-stream")
  endif()
  string(APPEND _body "static const unsigned char kData${_i}[] = {\n${_bytes}0x00};\n")
  string(APPEND _table "    {\"${_name}\", kData${_i}, ${_size}u, \"${_type}\"},\n")
  math(EXPR _i "${_i} + 1")
endforeach()

set(_out "// Generated by cmake/embed_ui.cmake - do not edit. Sources: ${FILES}\n#pragma once\n#include <cstddef>\n#include <string_view>\n\nnamespace veltra::ui {\n\nstruct EmbeddedFile {\n    const char* name;\n    const unsigned char* data;\n    std::size_t size;\n    const char* type;\n};\n\nnamespace detail {\n${_body}}  // namespace detail\nusing namespace detail;\n\nstatic const EmbeddedFile kFiles[] = {\n${_table}};\ninline constexpr std::size_t kNumFiles = ${_i};\n\nstatic inline const EmbeddedFile* find(std::string_view name) {\n    for (const EmbeddedFile& f : kFiles)\n        if (name == f.name) return &f;\n    return nullptr;\n}\n\n}  // namespace veltra::ui\n")

# only touch the header when the content changed (no needless rebuilds)
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _out)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_out}")
